# Copy to terraform.tfvars and adjust for your network.
# IPs must be outside your router's DHCP range.
nodes = {
  k8s-cp-01 = { vmid = 100, cores = 2, memory = 3072, disk = 20, ip = "192.168.0.100/24" }
  k8s-wk-01 = { vmid = 101, cores = 2, memory = 5120, disk = 30, ip = "192.168.0.101/24" }
  k8s-wk-02 = { vmid = 102, cores = 2, memory = 5120, disk = 30, ip = "192.168.0.102/24" }
}